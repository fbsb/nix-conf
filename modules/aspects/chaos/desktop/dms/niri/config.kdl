// This config is in the KDL format: https://kdl.dev
// "/-" comments out the following node.
// Check the wiki for a full description of the configuration:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction
config-notification {
    disable-failed
}

gestures {
    hot-corners {
        off
    }
}

input {
    keyboard {
        xkb { }
        numlock
    }

    mouse {
        accel-speed 0.0
        natural-scroll
    }

    touchpad {
        tap
        accel-speed 0.0
        accel-profile "adaptive"
        natural-scroll
        dwt
        scroll-method "two-finger"
    }

    trackpoint {
        // off
        natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "on-button-down"
        // scroll-button 273
        // scroll-button-lock
        // middle-emulation
    }

    warp-mouse-to-focus
}


layout {

    always-center-single-column
    center-focused-column "never"
    background-color "transparent"
    preset-column-widths {
        proportion 0.25
        proportion 0.5
        proportion 0.75
        proportion 0.98
    }
    default-column-width { proportion 0.98; }
    default-column-display "tabbed"
    tab-indicator {
        hide-when-single-tab
    }
}

output "Samsung Electric Company LS49AG95 HNTR900271" {
    focus-at-startup
    layout {
        default-column-width { proportion 0.5; }
    }
}

output "BOE NE135A1M-NY1 Unknown" {
    mode "2880x1920@120.000"
    scale 1.75
}

layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}
overview {
    workspace-shadow {
        off
    }
}
environment {
  XDG_CURRENT_DESKTOP "niri"
}
hotkey-overlay {
    skip-at-startup
}
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"
animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}
// Window rules let you adjust behavior for individual windows.
// Find more information on the wiki:
// https://github.com/YaLTeR/niri/wiki/Configuration:-Window-Rules
// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
window-rule {
    match app-id=r#"^org\.gnome\."#
    draw-border-with-background false
    geometry-corner-radius 12
    clip-to-geometry true
}
window-rule {
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width { proportion 0.5; }
    open-floating false
}
window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id=r#"^gnome-calculator$"#
    match app-id=r#"^galculator$"#
    match app-id=r#"^blueman-manager$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    match app-id=r#"^xdg-desktop-portal$"#
    open-floating true
}
window-rule {
    match app-id=r#"^steam$"# title=r#"^notificationtoasts_\d+_desktop$"#
    default-floating-position x=10 y=10 relative-to="bottom-right"
    open-focused false
}
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    match app-id="Alacritty"
    match app-id="zen"
    match app-id="com.mitchellh.ghostty"
    match app-id="kitty"
    draw-border-with-background false
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    match app-id="zoom"
    open-floating true
}
debug {
    honor-xdg-activation-with-invalid-serial
}

// Override to disable super+tab
recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
}

binds {
    // focus window or workspace
    Mod+Up hotkey-overlay-title="Focus Up" { focus-window-or-workspace-up; }
    Mod+Down hotkey-overlay-title="Focus Down" { focus-window-or-workspace-down; }
    Mod+Left hotkey-overlay-title="Focus Left" { focus-column-left; }
    Mod+Right hotkey-overlay-title="Focus Right" { focus-column-right; }

    // focus monitor
    Mod+Ctrl+Up hotkey-overlay-title="Focus Monitor Up" { focus-monitor-up; }
    Mod+Ctrl+Down hotkey-overlay-title="Focus Monitor Down" { focus-monitor-down; }
    Mod+Ctrl+Left hotkey-overlay-title="Focus Monitor Left" { focus-monitor-left; }
    Mod+Ctrl+Right hotkey-overlay-title="Focus Monitor Right" { focus-monitor-right; }

    // move workspace
    Mod+Alt+Up hotkey-overlay-title="Move Workspace to Monitor Up" { move-workspace-to-monitor-up; }
    Mod+Alt+Down hotkey-overlay-title="Move Workspace to Monitor Down" { move-workspace-to-monitor-down; }
    Mod+Alt+Left hotkey-overlay-title="Move Workspace to Monitor Left" { move-workspace-to-monitor-left; }
    Mod+Alt+Right hotkey-overlay-title="Move Workspace to Monitor Right" { move-workspace-to-monitor-right; }

    // move column to monitor
    Mod+Ctrl+Shift+Up hotkey-overlay-title="Move Column to Monitor Up" { move-column-to-monitor-up; }
    Mod+Ctrl+Shift+Down hotkey-overlay-title="Move Column to Monitor Down" { move-column-to-monitor-down; }
    Mod+Ctrl+Shift+Left hotkey-overlay-title="Move Column to Monitor Left" { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+Right hotkey-overlay-title="Move Column to Monitor Right" { move-column-to-monitor-right; }

    // move window around
    Mod+Shift+Up hotkey-overlay-title="Move Window Up" { move-window-up-or-to-workspace-up; }
    Mod+Shift+Down hotkey-overlay-title="Move Window Down" { move-window-down-or-to-workspace-down; }
    Mod+Shift+Left hotkey-overlay-title="Move Window Left" { consume-or-expel-window-left; }
    Mod+Shift+Right hotkey-overlay-title="Move Window Right" { consume-or-expel-window-right; }

    Mod+T hotkey-overlay-title="Toggle Tabbed" { toggle-column-tabbed-display; }
    Mod+Shift+F hotkey-overlay-title="Toggle Floating" { toggle-window-floating; }
    Mod+C hotkey-overlay-title="Center Column" { center-column; }
    Mod+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+M hotkey-overlay-title="Maximize Column" { maximize-column; }
    Mod+D hotkey-overlay-title="Switch Floating/Tiling Focus" { switch-focus-between-floating-and-tiling; }

    Mod+Shift+Slash hotkey-overlay-title="Show Hotkey Overlay" { show-hotkey-overlay; }
    Mod+Return hotkey-overlay-title="Ghostty" { spawn "ghostty"; }
    Mod+S hotkey-overlay-title="Screenshot (Interactive)" { screenshot; }
    Mod+Shift+S hotkey-overlay-title="Screenshot Window" { screenshot-window; }
    Mod+W hotkey-overlay-title="Cycle Column Width" { switch-preset-column-width; }

    Mod+Q allow-inhibiting=false hotkey-overlay-title="Close Window" { close-window; }
    Mod+Escape allow-inhibiting=false hotkey-overlay-title="Toggle Shortcuts Inhibit" { toggle-keyboard-shortcuts-inhibit; }

    // media keys
    XF86AudioLowerVolume hotkey-overlay-title="Volume Down (5%)" { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute hotkey-overlay-title="Volume Mute Toggle" { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioNext hotkey-overlay-title="Media: Next Track" { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86AudioPlay hotkey-overlay-title="Media: Play/Pause" { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPrev hotkey-overlay-title="Media: Previous Track" { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioRaiseVolume hotkey-overlay-title="Volume Up (5%)" { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86MonBrightnessDown hotkey-overlay-title="Brightness Down (5%)" { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }
    XF86MonBrightnessUp hotkey-overlay-title="Brightness Up (5%)" { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }

    Mod+Comma hotkey-overlay-title="Settings: Focus or Toggle" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+E hotkey-overlay-title="Default File Manager: Open" { spawn "dms" "ipc" "call" "defaultApp" "fileManager"; }
    Mod+N hotkey-overlay-title="Notifications: Toggle" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+L allow-inhibiting=false hotkey-overlay-title="Lock Screen" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+space hotkey-overlay-title="Default Launcher: Toggle" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
}

// Include dms files
include optional=true "dms/colors.kdl"
include optional=true "dms/layout.kdl"
include optional=true "dms/alttab.kdl"
include optional=true "dms/binds.kdl"
include optional=true "dms/outputs.kdl"
include optional=true "dms/cursor.kdl"
include optional=true "dms/input.kdl"
include optional=true "dms/windowrules.kdl"
